# Supabase (seguro expor no cliente: quem isola os dados é o RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Segredos das Edge Functions (NUNCA prefixar com VITE_, nunca vão para o bundle).
# Configurar com `npx supabase secrets set`, não aqui:
#   EVOLUTION_API_URL=
#   EVOLUTION_API_KEY=
#   EVOLUTION_INSTANCE=
